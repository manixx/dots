shadow = false;
fading = false;
corner-radius = 0
blur-method = "dual_kawase"
blur-strength = 5
rules = (
  {
    match = "window_type = 'dock' || window_type = 'desktop' || class_g != 'st-256color' || _GTK_FRAME_EXTENTS@";
    blur-background = false;
  },
  {
    match = "class_g = 'Chromium' && name *= 'YouTube'";
    opacity = 0.5;
  }
);
backend = "glx";
vsync = true;
